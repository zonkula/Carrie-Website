# Copy to .env (which is gitignored) and fill in. Never commit real keys.
# Every value is optional: a missing service just stays switched off.

# --- Payments: Stripe -------------------------------------------------------
# Secret key from https://dashboard.stripe.com/test/apikeys
# Test-mode keys only for now: the checkout endpoint refuses live keys.
STRIPE_SECRET_KEY=sk_test_replace_me

# --- Contact form: Resend (emails each message to her) ----------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Where messages are delivered (her inbox).
CONTACT_TO_EMAIL=
# Sender address. Must be on a domain verified in Resend, e.g. "Website <hello@herdomain.com>".
# For a first test before the domain is verified, use "onboarding@resend.dev"
# (Resend then only delivers to the email address on the Resend account).
CONTACT_FROM_EMAIL=

# --- Email signup: Buttondown (her mailing list) -----------------------------
# API key from https://buttondown.com/settings/programming
BUTTONDOWN_API_KEY=
