---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { Content as Commissions } from '../content/commissions.md';
import { TOPICS } from '../lib/forms';
import { site } from '../site.config';
---

<Base title="Contact and Commissions" description={`Get in touch with ${site.name} about a painting, a commission or prints.`} footerSignup={false}>
  <SiteHeader />

  <main class="contact">
    <header class="fade-in">
      <h1>Contact and Commissions</h1>
      <p class="lede">Questions about a painting, prints or a commission are always welcome.</p>
    </header>

    <section class="block fade-in" style="--delay: 0.2s" aria-labelledby="commissions-title">
      <h2 id="commissions-title">Commissions</h2>
      <div class="prose"><Commissions /></div>
    </section>

    <section class="block fade-in" style="--delay: 0.35s" id="inquiry" aria-labelledby="inquiry-title">
      <h2 id="inquiry-title">Send a message</h2>
      <p class="notice" role="status" hidden data-notice="inquiry"></p>

      <form method="post" action="/api/inquiry" class="form" data-form>
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
        </div>
        <div class="field">
          <label for="topic">About</label>
          <select id="topic" name="topic">
            {TOPICS.map((t) => <option>{t}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required maxlength="5000"></textarea>
        </div>
        {/* Spam trap: hidden from people, often filled in by bots. */}
        <div class="trap" aria-hidden="true">
          <label for="website-1">Leave this empty</label>
          <input id="website-1" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="button">Send message</button>
      </form>
    </section>

    <section class="block signup fade-in" style="--delay: 0.5s" id="signup" aria-labelledby="signup-title">
      <h2 id="signup-title">New work by email</h2>
      <p class="sub">An occasional note when new paintings are available. No spam, unsubscribe any time.</p>
      <p class="notice" role="status" hidden data-notice="signup"></p>

      <form method="post" action="/api/subscribe" class="signup-form" data-form>
        <label for="signup-email" class="visually-hidden">Email address</label>
        <input id="signup-email" name="email" type="email" autocomplete="email" placeholder="Email address" required maxlength="200" />
        <div class="trap" aria-hidden="true">
          <label for="website-2">Leave this empty</label>
          <input id="website-2" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="button">Sign up</button>
      </form>
    </section>
  </main>
</Base>

<script>
  // Show the result after a form posts and comes back (?inquiry=sent, ?signup=error, ...).
  const messages: Record<string, Record<string, string>> = {
    inquiry: {
      sent: 'Thank you. Your message is on its way, and you will hear back soon.',
      invalid: 'Please add your name, a valid email and a message.',
      error: 'Sorry, your message could not be sent. Please try again in a moment.',
    },
    signup: {
      sent: 'Thank you. You are on the list.',
      invalid: 'Please enter a valid email address.',
      error: 'Sorry, that did not go through. Please try again in a moment.',
    },
  };

  // Keep what the visitor typed so a failed send doesn't lose their message.
  // Saved only for this browser tab, and cleared once the message is sent.
  const DRAFT_KEY = 'contact-draft';
  const draftFields = ['name', 'email', 'topic', 'message'];
  const store = {
    get: () => {
      try {
        return JSON.parse(sessionStorage.getItem(DRAFT_KEY) ?? 'null') as Record<string, string> | null;
      } catch {
        return null;
      }
    },
    set: (v: Record<string, string>) => {
      try {
        sessionStorage.setItem(DRAFT_KEY, JSON.stringify(v));
      } catch {}
    },
    clear: () => {
      try {
        sessionStorage.removeItem(DRAFT_KEY);
      } catch {}
    },
  };

  document.querySelector('form[action="/api/inquiry"]')?.addEventListener('submit', () => {
    const draft: Record<string, string> = {};
    for (const id of draftFields) draft[id] = (document.getElementById(id) as HTMLInputElement | null)?.value ?? '';
    store.set(draft);
  });

  const params = new URLSearchParams(location.search);

  // Links like /contact/?topic=Prints pre-select the topic.
  const topic = params.get('topic');
  const topicSelect = document.getElementById('topic') as HTMLSelectElement | null;
  if (topic && topicSelect && [...topicSelect.options].some((o) => o.value === topic)) topicSelect.value = topic;
  params.delete('topic');

  const inquiryState = params.get('inquiry');
  if (inquiryState === 'sent') store.clear();
  else if (inquiryState === 'error' || inquiryState === 'invalid') {
    const draft = store.get();
    if (draft) {
      for (const id of draftFields) {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (el && draft[id]) el.value = draft[id];
      }
    }
  }

  for (const kind of Object.keys(messages)) {
    const state = params.get(kind);
    const el = document.querySelector<HTMLElement>(`[data-notice="${kind}"]`);
    if (state && el && messages[kind][state]) {
      el.textContent = messages[kind][state];
      el.dataset.state = state;
      el.hidden = false;
      params.delete(kind);
    }
  }
  if (location.search) history.replaceState(null, '', location.pathname + (params.size ? `?${params}` : '') + location.hash);

  // Prevent double submits.
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((form) =>
    form.addEventListener('submit', () => {
      const button = form.querySelector('button');
      if (button) button.disabled = true;
    }),
  );
  addEventListener('pageshow', (e) => {
    if (e.persisted) document.querySelectorAll<HTMLButtonElement>('[data-form] button').forEach((b) => (b.disabled = false));
  });
</script>

<style>
  .contact {
    max-width: 34rem;
    margin: 0 auto;
    padding: 0 var(--gutter) var(--space-5);
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.15;
  }

  h1 {
    font-size: 2.25rem;
    text-wrap: balance;
  }

  h2 {
    font-size: 1.625rem;
  }

  .lede {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .block {
    margin-top: var(--space-5);
    scroll-margin-top: var(--space-3);
  }

  .block + .block {
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .prose {
    margin-top: var(--space-2);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .prose :global(p) {
    margin: 0 0 1em;
  }

  .sub {
    margin: var(--space-2) 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  /* ---------- Forms ---------- */
  .form {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--rule);
    border-radius: 0;
    background: #fff;
    color: var(--text);
    font: inherit;
    font-size: 1rem; /* 16px stops iPhones zooming in on focus */
    transition: border-color 0.6s var(--ease);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--text);
  }

  select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%),
      linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position: calc(100% - 1.15rem) 50%, calc(100% - 0.8rem) 50%;
    background-size: 0.35rem 0.35rem;
    background-repeat: no-repeat;
    padding-right: 2.25rem;
  }

  textarea {
    resize: vertical;
    min-height: 9rem;
    line-height: 1.6;
  }

  .button {
    padding: 1rem 1.5rem;
    border: 1px solid var(--text);
    background: var(--text);
    color: var(--bg);
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.6s var(--ease), color 0.6s var(--ease);
  }

  .button:hover {
    background: transparent;
    color: var(--text);
  }

  .button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .signup-form {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-3);
  }

  @media (min-width: 30rem) {
    .signup-form {
      grid-template-columns: 1fr auto;
      gap: 0;
    }

    .signup-form input {
      border-right: 0;
    }
  }

  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .notice {
    margin: var(--space-3) 0 0;
    padding: var(--space-2);
    border: 1px solid var(--rule);
    font-size: 0.9375rem;
    animation: fade-in var(--fade) var(--ease) both;
  }

  .notice[hidden] {
    display: none;
  }

  .notice[data-state='invalid'],
  .notice[data-state='error'] {
    border-color: var(--sold);
  }

  @media (min-width: 48rem) {
    h1 {
      font-size: 2.75rem;
    }
  }
</style>
