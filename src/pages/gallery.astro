---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PaintingCard from '../components/PaintingCard.astro';

// Series in their `order`; paintings in the order they appear in paintings.yaml.
const allSeries = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);
const paintings = await getCollection('paintings');

const groups = allSeries
  .map((series) => ({ series, works: paintings.filter((p) => p.data.series.id === series.id) }))
  .filter((g) => g.works.length > 0);
---

<Base title="Gallery" description="Current paintings, grouped by series. Sold work stays visible.">
  <SiteHeader />

  <main class="gallery">
    <header class="page-head fade-in">
      <h1>Gallery</h1>
      {
        groups.length > 1 && (
          <nav aria-label="Series">
            <ul class="series-nav">
              {groups.map(({ series }) => (
                <li>
                  <a href={`#${series.id}`}>{series.data.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </header>

    {
      groups.map(({ series, works }, i) => (
        <section class="series fade-in" id={series.id} style={`--delay: ${0.2 + i * 0.15}s`} aria-labelledby={`${series.id}-title`}>
          <div class="series-head">
            <h2 id={`${series.id}-title`}>{series.data.title}</h2>
            <p class="intro">{series.data.intro}</p>
          </div>

          <ul class="painting-grid">
            {works.map((painting) => (
              <li class="card">
                <PaintingCard painting={painting} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Base>

<style>
  .gallery {
    max-width: 90rem;
    margin: 0 auto;
    padding: 0 var(--gutter) var(--space-5);
  }

  /* ---------- Page head ---------- */
  .page-head {
    text-align: center;
    margin: var(--space-2) 0 var(--space-4);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 2.25rem;
    line-height: 1.1;
  }

  .series-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .series-nav a {
    display: inline-block;
    padding: 0.5rem 0; /* comfortable tap target */
    color: var(--muted);
    text-decoration: none;
    transition: color 0.6s var(--ease);
  }

  .series-nav a:hover {
    color: var(--text);
  }

  /* Series links glide to their section. Skipped if the visitor prefers reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }

  /* ---------- Series ---------- */
  .series {
    scroll-margin-top: var(--space-3);
  }

  .series + .series {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .series-head {
    max-width: 36rem;
    margin: 0 auto var(--space-4);
    text-align: center;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .intro {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

</style>
