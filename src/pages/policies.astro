---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import * as policies from '../content/policies.md';

const sections = policies.getHeadings().filter((h) => h.depth === 2);
---

<Base title="Policies" description="Shipping, returns, framing and print information.">
  <SiteHeader />

  <main class="policies">
    <header class="fade-in">
      <h1>Policies</h1>
      <p class="updated">Last updated: {policies.frontmatter.updated}</p>
      <nav aria-label="On this page">
        <ul class="toc">
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.slug}`}>{s.text}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <div class="prose fade-in" style="--delay: 0.2s">
      <policies.Content />
    </div>
  </main>
</Base>

<style>
  .policies {
    max-width: 38rem;
    margin: 0 auto;
    padding: 0 var(--gutter) var(--space-5);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 2.25rem;
    line-height: 1.15;
  }

  .updated {
    margin: var(--space-1) 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin: var(--space-3) 0 0;
    padding: var(--space-1) 0;
    border-block: 1px solid var(--rule);
    list-style: none;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .toc a {
    display: inline-block;
    padding: 0.5rem 0;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.6s var(--ease);
  }

  .toc a:hover {
    color: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }

  .prose {
    font-size: 1rem;
    line-height: 1.7;
  }

  .prose :global(h2) {
    margin: var(--space-5) 0 var(--space-2);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.625rem;
    line-height: 1.2;
    scroll-margin-top: var(--space-3);
  }

  .prose :global(p) {
    margin: 0 0 1em;
  }

  .prose :global(strong) {
    font-weight: 500;
  }

  .prose :global(a) {
    text-underline-offset: 0.2em;
  }

  @media (min-width: 48rem) {
    h1 {
      font-size: 2.75rem;
    }
  }
</style>
