---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PaintingCard from '../components/PaintingCard.astro';
import { formatPrice } from '../lib/format';

const paintings = await getCollection('paintings');
const originals = paintings.filter((p) => p.data.status === 'available');
const withPrints = paintings.filter((p) => p.data.prints);

const edition = (prints: NonNullable<(typeof paintings)[number]['data']['prints']>) =>
  prints.edition === 'limited' ? `Limited edition of ${prints.editionSize}` : 'Open edition';
---

<Base title="Shop" description="Original paintings and fine art prints, with prices.">
  <SiteHeader />

  <main class="shop">
    <header class="page-head fade-in">
      <h1>Shop</h1>
      <nav aria-label="Shop sections">
        <ul class="section-nav">
          <li><a href="#originals">Originals</a></li>
          <li><a href="#prints">Prints</a></li>
        </ul>
      </nav>
    </header>

    <!-- ---------- Originals ---------- -->
    <section class="section fade-in" id="originals" style="--delay: 0.2s" aria-labelledby="originals-title">
      <div class="section-head">
        <h2 id="originals-title">Originals</h2>
        <p class="intro">One of a kind, with a certificate of authenticity. Each ships insured, with tracking.</p>
      </div>

      {
        originals.length > 0 ? (
          <ul class="painting-grid">
            {originals.map((painting) => (
              <li>
                <PaintingCard painting={painting} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">
            Every current original has found a home. <a href="#signup">Join the email list</a> to hear about new work first.
          </p>
        )
      }
      <p class="more"><a href="/gallery/">View all work in the gallery</a></p>
    </section>

    <!-- ---------- Prints ---------- -->
    <section class="section fade-in" id="prints" style="--delay: 0.35s" aria-labelledby="prints-title">
      <div class="section-head">
        <h2 id="prints-title">Prints</h2>
        <p class="intro">Fine art prints made from high-resolution photographs of the originals.</p>
        {/* PLACEHOLDER: print fulfilment is still undecided (SPEC.md). Replace once prints can be ordered online. */}
        <p class="soon">Online print ordering opens soon. Until then, <a href="/contact/?topic=Prints#inquiry">ask about a print</a> and it can be arranged directly.</p>
      </div>

      {
        withPrints.length > 0 ? (
          <ul class="prints">
            {withPrints.map(({ id, data }) => (
              <li class="print">
                <a href={`/paintings/${id}/`} class="print-thumb" tabindex="-1" aria-hidden="true">
                  <Image src={data.images.main} alt="" widths={[240, 480]} sizes="(min-width: 40rem) 10rem, 7rem" loading="lazy" />
                </a>
                <div class="print-body">
                  <h3>
                    <a href={`/paintings/${id}/`}>{data.title}</a>
                  </h3>
                  <p class="edition">{edition(data.prints!)}</p>
                  <table class="options">
                    <caption class="visually-hidden">Print sizes and prices for {data.title}</caption>
                    <thead>
                      <tr>
                        <th scope="col">Size (in)</th>
                        <th scope="col">Paper</th>
                        <th scope="col">Price</th>
                      </tr>
                    </thead>
                    <tbody>
                      {data.prints!.options.map((o) => (
                        <tr>
                          <td>{o.size}</td>
                          <td>{o.paper}</td>
                          <td>{formatPrice(o.price)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">No prints are available yet.</p>
        )
      }
      <p class="more"><a href="/policies/#prints">How prints are made and shipped</a></p>
    </section>
  </main>
</Base>

<style>
  .shop {
    max-width: 90rem;
    margin: 0 auto;
    padding: 0 var(--gutter) var(--space-5);
  }

  .page-head {
    text-align: center;
    margin: var(--space-2) 0 var(--space-4);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.15;
  }

  h1 {
    font-size: 2.25rem;
  }

  h2 {
    font-size: 1.75rem;
  }

  .section-nav {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-nav a {
    display: inline-block;
    padding: 0.5rem 0;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.6s var(--ease);
  }

  .section-nav a:hover {
    color: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }

  .section {
    scroll-margin-top: var(--space-3);
  }

  .section + .section {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .section-head {
    max-width: 36rem;
    margin: 0 auto var(--space-4);
    text-align: center;
  }

  .intro {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .soon {
    margin: var(--space-2) 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .soon a,
  .empty a {
    color: var(--text);
    text-underline-offset: 0.2em;
  }

  .empty {
    max-width: 30rem;
    margin: 0 auto;
    text-align: center;
  }

  .more {
    margin: var(--space-4) 0 0;
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .more a {
    display: inline-block;
    padding: 0.5rem 0;
    color: var(--muted);
    text-underline-offset: 0.4em;
    text-decoration-color: var(--rule);
  }

  .more a:hover {
    color: var(--text);
  }

  /* ---------- Prints list ---------- */
  .prints {
    display: grid;
    gap: var(--space-4);
    max-width: 48rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .print {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-3);
    align-items: start;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .print:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .print-thumb :global(img) {
    width: 100%;
    height: auto;
  }

  h3 {
    font-size: 1.375rem;
    font-style: italic;
  }

  h3 a {
    text-decoration: none;
  }

  .edition {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .options {
    width: 100%;
    margin-top: var(--space-2);
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .options th {
    padding: 0 0 0.4rem;
    text-align: left;
    font-weight: 400;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--muted);
  }

  .options td {
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-top: 1px solid var(--rule);
    vertical-align: top;
  }

  .options th:last-child,
  .options td:last-child {
    padding-right: 0;
    text-align: right;
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .print {
      grid-template-columns: 10rem 1fr;
      gap: var(--space-4);
    }
  }

  @media (min-width: 48rem) {
    h1 {
      font-size: 2.75rem;
    }
  }
</style>
