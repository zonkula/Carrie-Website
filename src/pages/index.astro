---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../site.config';
import { formatPrice, formatSize, statusLabel } from '../lib/format';

// Hero: the first painting marked `featured: true` in src/data/paintings.yaml.
const paintings = await getCollection('paintings');
const hero = paintings.find((p) => p.data.featured) ?? paintings[0];
if (!hero) throw new Error('Homepage needs at least one painting in src/data/paintings.yaml');

const { title, year, medium, price, status, alt, images, dimensions } = hero.data;
const href = `/paintings/${hero.id}/`;
---

<Base>
  <SiteHeader />

  <main class="home">
    <figure class="hero fade-in" style="--delay: 0.2s">
      <a href={href} tabindex="-1" aria-hidden="true"><Picture
        src={images.main}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600, 2000].filter((w) => w <= images.main.width)}
        sizes="(min-width: 64rem) 56rem, calc(100vw - 2rem)"
        loading="eager"
        fetchpriority="high"
      /></a>
      <figcaption>
        <a class="title" href={href}>{title}</a>, {year}{' '}
        <span class="sep" aria-hidden="true">·</span>{' '}
        {medium}, <span class="nowrap">{formatSize(dimensions)}</span>{' '}
        <span class="sep" aria-hidden="true">·</span>{' '}
        <span class="nowrap">{formatPrice(price)}{status !== 'available' && `, ${statusLabel[status]}`}</span>
      </figcaption>
    </figure>

    <section class="intro fade-in" style="--delay: 0.9s">
      <h1 class="visually-hidden">{site.name}</h1>
      <p class="line">{site.intro}</p>
      <a class="cta" href="/gallery/">View the gallery</a>
      <p class="secondary"><a href="/shop/">or visit the shop</a></p>
    </section>
  </main>
</Base>

<style>
  .home {
    padding: 0 var(--gutter) var(--space-5);
  }

  .hero {
    margin: var(--space-2) auto 0;
    max-width: 56rem;
  }

  /* Never crop the painting: scale it to fit, keep its proportions. */
  /* Height leaves room for the caption, intro and link on first view. */
  .hero :global(img) {
    width: 100%;
    max-height: max(14rem, calc(100svh - 27rem));
    object-fit: contain;
    margin: 0 auto;
  }

  figcaption {
    margin-top: var(--space-2);
    text-align: center;
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.5;
  }

  /* Never split "30 × 24 in" or a price across lines. */
  .nowrap {
    white-space: nowrap;
  }

  .title {
    font-style: italic;
    color: var(--text);
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }

  .sep {
    margin: 0 0.1em;
  }

  .intro {
    margin: var(--space-4) auto 0;
    max-width: 32rem;
    text-align: center;
  }

  .line {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.35;
    text-wrap: balance;
  }

  /* Clear but quiet: a text link with a hairline, sized for a thumb. */
  .cta {
    display: inline-block;
    margin-top: var(--space-4);
    padding: 0.85rem 1.75rem;
    border: 1px solid var(--text);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.6s var(--ease), color 0.6s var(--ease);
  }

  .secondary {
    margin: var(--space-1) 0 0;
    font-size: 0.8125rem;
  }

  .secondary a {
    display: inline-block;
    padding: 0.5rem 0;
    color: var(--muted);
    text-underline-offset: 0.3em;
    text-decoration-color: var(--rule);
    transition: color 0.6s var(--ease);
  }

  .secondary a:hover {
    color: var(--text);
  }

  .cta:hover {
    background: var(--text);
    color: var(--bg);
  }

  @media (min-width: 48rem) {
    .line {
      font-size: 1.875rem;
    }
  }
</style>
