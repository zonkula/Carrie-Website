---
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../site.config';
import { formatPrice } from '../lib/format';
import { SHARE_IMAGE, shareImagePath } from '../lib/share';

/** What a link preview (text message, social post) shows for this page. */
export interface Share {
  title: string;
  description: string;
  /** The painting whose image the preview shows. */
  paintingId: string;
  imageAlt: string;
  /** Painting pages: price in US dollars, and whether it can be bought. */
  price?: number;
  available?: boolean;
}

interface Props {
  title?: string;
  description?: string;
  /** Show the email signup in the footer (default true). */
  footerSignup?: boolean;
  /** Link preview. Leave out to use the homepage's featured painting. */
  share?: Share;
}

const { title, description = site.description, footerSignup = true } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;

// Default preview: the featured painting (the homepage hero), with its title and price.
let share = Astro.props.share;
if (!share) {
  const paintings = await getCollection('paintings');
  const hero = paintings.find((p) => p.data.featured) ?? paintings[0];
  share = {
    title: pageTitle,
    description: hero ? `${description} Featured: ${hero.data.title}, ${formatPrice(hero.data.price)}.` : description,
    paintingId: hero!.id,
    imageAlt: hero?.data.alt ?? '',
  };
}

// Previews need full URLs. SITE_URL (astro.config.mjs) gives the real domain; without it,
// the local address is used, which works for checking the tags but not for real sharing.
const base = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, base).href;
const card = SHARE_IMAGE;
const imageUrl = new URL(shareImagePath(share.paintingId), base).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f5" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <!-- Link previews: Open Graph (iMessage, WhatsApp, Facebook, LinkedIn, Slack, ...) -->
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={share.price !== undefined ? 'product' : 'website'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={share.title} />
    <meta property="og:description" content={share.description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(card.width)} />
    <meta property="og:image:height" content={String(card.height)} />
    <meta property="og:image:alt" content={share.imageAlt} />
    {
      share.price !== undefined && (
        <>
          <meta property="product:price:amount" content={String(share.price)} />
          <meta property="product:price:currency" content="USD" />
          <meta property="product:availability" content={share.available ? 'in stock' : 'out of stock'} />
        </>
      )
    }

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={share.title} />
    <meta name="twitter:description" content={share.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={share.imageAlt} />

    <slot name="head" />
  </head>
  <body>
    <slot />
    <SiteFooter signup={footerSignup} />
  </body>
</html>
