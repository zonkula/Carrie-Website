---
import { site } from '../site.config';

interface Props {
  /** Show the email signup. Off on the Contact page, which has its own. */
  signup?: boolean;
}

const { signup = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  {
    signup && (
      <section class="signup" id="signup" aria-labelledby="footer-signup-title">
        <p id="footer-signup-title" class="signup-title">
          New work by email, now and then.
        </p>
        <p class="notice" role="status" hidden data-footer-notice />
        <form method="post" action="/api/subscribe" class="signup-form" data-footer-form>
          <input type="hidden" name="from" value={Astro.url.pathname} />
          <label for="footer-email" class="visually-hidden">
            Email address
          </label>
          <input id="footer-email" name="email" type="email" autocomplete="email" placeholder="Email address" required maxlength="200" />
          <div class="trap" aria-hidden="true">
            <label for="footer-website">Leave this empty</label>
            <input id="footer-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <button type="submit">Sign up</button>
        </form>
      </section>
    )
  }

  <div class="bottom">
    <nav aria-label="Footer">
      <ul>
        <li><a href="/policies/">Policies</a></li>
        <li><a href="/contact/">Contact</a></li>
        {site.instagram && <li><a href={site.instagram} rel="me noopener">Instagram</a></li>}
      </ul>
    </nav>
    <p class="copy">© {year} {site.name}. All artwork and images are copyright the artist.</p>
  </div>
</footer>

<script>
  // Show the signup result after the form posts back to this page (?signup=sent|invalid|error).
  const messages: Record<string, string> = {
    sent: 'Thank you. You are on the list.',
    invalid: 'Please enter a valid email address.',
    error: 'Sorry, that did not go through. Please try again in a moment.',
  };
  const params = new URLSearchParams(location.search);
  const state = params.get('signup');
  const notice = document.querySelector<HTMLElement>('[data-footer-notice]');
  if (state && notice && messages[state]) {
    notice.textContent = messages[state];
    notice.dataset.state = state;
    notice.hidden = false;
    params.delete('signup');
    history.replaceState(null, '', location.pathname + (params.size ? `?${params}` : '') + location.hash);
  }
  document.querySelector<HTMLFormElement>('[data-footer-form]')?.addEventListener('submit', (e) => {
    const button = (e.currentTarget as HTMLFormElement).querySelector('button');
    if (button) button.disabled = true;
  });
  addEventListener('pageshow', (e) => {
    const button = document.querySelector<HTMLButtonElement>('[data-footer-form] button');
    if (e.persisted && button) button.disabled = false;
  });
</script>

<style>
  .site-footer {
    margin-top: auto;
    padding: var(--space-4) var(--gutter) var(--space-3);
    border-top: 1px solid var(--rule);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* ---------- Signup ---------- */
  .signup {
    max-width: 30rem;
    margin: 0 auto var(--space-4);
    text-align: center;
    scroll-margin-top: var(--space-4);
  }

  .signup-title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--text);
  }

  .signup-form {
    display: grid;
    gap: var(--space-1);
  }

  .signup-form input[type='email'] {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--rule);
    border-radius: 0;
    background: #fff;
    color: var(--text);
    font: inherit;
    font-size: 1rem; /* 16px stops iPhones zooming in on focus */
  }

  .signup-form input[type='email']:focus {
    outline: none;
    border-color: var(--text);
  }

  .signup-form button {
    padding: 0.85rem 1.5rem;
    border: 1px solid var(--text);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.6s var(--ease), color 0.6s var(--ease);
  }

  .signup-form button:hover {
    background: var(--text);
    color: var(--bg);
  }

  .signup-form button:disabled {
    opacity: 0.6;
  }

  @media (min-width: 30rem) {
    .signup-form {
      grid-template-columns: 1fr auto;
      gap: 0;
    }

    .signup-form input[type='email'] {
      border-right: 0;
    }
  }

  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .notice {
    margin: 0 0 var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--rule);
    color: var(--text);
    animation: fade-in var(--fade) var(--ease) both;
  }

  .notice[hidden] {
    display: none;
  }

  .notice[data-state='invalid'],
  .notice[data-state='error'] {
    border-color: var(--sold);
  }

  /* ---------- Bottom row ---------- */
  .bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    text-align: center;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    display: inline-block;
    padding: 0.5rem 0;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.6s var(--ease);
  }

  ul a:hover {
    color: var(--text);
  }

  .copy {
    margin: 0;
    font-size: 0.75rem;
  }

  @media (min-width: 48rem) {
    .bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
