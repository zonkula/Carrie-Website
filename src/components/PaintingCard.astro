---
import type { CollectionEntry } from 'astro:content';
import { Picture, Image } from 'astro:assets';
import { formatPrice, formatSize, statusLabel } from '../lib/format';

interface Props {
  painting: CollectionEntry<'paintings'>;
}

const { id, data } = Astro.props.painting;
const main = data.images.main;
const closeup = data.images.closeups[0];

const widths = (max: number) => [400, 600, 800, 1200].filter((w) => w <= max);
const sizes = '(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, calc(100vw - 2rem)';
---

<a href={`/paintings/${id}/`} class:list={['card-link', data.status]}>
  {/* With 2+ columns the frame is the same shape for every card; the painting sits inside it, never cropped. */}
  <div class="frame">
    <div class="art" style={`--ar: ${main.width / main.height}`}>
      <Picture src={main} alt={data.alt} formats={['avif', 'webp']} widths={widths(main.width)} sizes={sizes} loading="lazy" />
      {
        closeup && (
          <Image class="closeup" src={closeup} alt="" aria-hidden="true" widths={widths(closeup.width)} sizes={sizes} loading="lazy" />
        )
      }
    </div>
  </div>
  <p class="caption">
    <span class="title">{data.title}</span>
    <span class="meta">{formatSize(data.dimensions)}</span>
    <span class="meta">
      {formatPrice(data.price)}
      {
        data.status !== 'available' && (
          <span class="status">
            <span class="dot" aria-hidden="true" />
            {statusLabel[data.status]}
          </span>
        )
      }
    </span>
    <slot />
  </p>
</a>

<style>
  .card-link {
    display: block;
    text-decoration: none;
  }

  /*
    Phones (one column): the painting at its own proportions, capped so a tall piece
    still fits on screen. Never cropped.
  */
  .frame {
    container-type: inline-size;
    display: flex;
    justify-content: center;
  }

  .art {
    position: relative;
    width: min(100cqw, calc(75svh * var(--ar)));
    aspect-ratio: var(--ar);
  }

  /*
    Two or more columns: a same-shaped frame for every card so rows line up. The painting
    is sized to fit inside it (like object-fit: contain), resting on the bottom edge.
  */
  @media (min-width: 40rem) {
    .frame {
      aspect-ratio: 4 / 5;
      align-items: flex-end;
    }

    .art {
      width: min(100cqw, calc(125cqw * var(--ar)));
    }
  }

  .art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Close-up on hover: desktop only. Hidden (and not downloaded) on touch screens. */
  .art :global(.closeup) {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .art :global(.closeup) {
      display: block;
      position: absolute;
      inset: 0;
      object-fit: cover;
      opacity: 0;
      transition: opacity 0.9s var(--ease);
    }

    .card-link:hover .art :global(.closeup),
    .card-link:focus-visible .art :global(.closeup) {
      opacity: 1;
    }
  }

  /* ---------- Caption ---------- */
  .caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: var(--space-2) 0 0;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-style: italic;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.6s var(--ease);
  }

  .card-link:hover .title {
    text-decoration-color: var(--rule);
  }

  .meta {
    color: var(--muted);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-left: 0.6em;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* The gallery red dot: filled for sold, outlined for reserved. */
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--sold);
  }

  .reserved .dot {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--sold);
  }
</style>
